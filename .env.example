# Скопіюйте у .env або передайте змінною оточення:
#     GROQ_API_KEY=... python3 run.py
#
# Ключ береться з оточення, а якщо його там немає — з файлу .env поруч
# із run.py. Без ключа прогін падає навмисно і results.jsonl не пише:
# результати, де частина відповідей стала «не знаю» через недоступну
# модель, не можна віддавати як валідні.
GROQ_API_KEY=
